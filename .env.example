# mock (default): everything runs on local fixtures, no keys, no cost.
# real: photos go to World Labs Marble.
AI_MODE=mock

# Required when AI_MODE=real. https://platform.worldlabs.ai/api-keys
WORLDLABS_API_KEY=

# marble-1.1 (default, 1,580 credits ≈ $1.26 per photo, ~5 min)
# marble-1.0-draft (230 credits ≈ $0.18, ~1 min, softer) for development
WORLDLABS_MODEL=marble-1.1

# Generating on your key needs a code. code:limit, comma-separated, "*" = unlimited.
ACCESS_CODES=
DAILY_GENERATION_LIMIT=3
IP_HOURLY_LIMIT=2
OWN_KEY_IP_HOURLY_LIMIT=10
# "ask for a trial" link, e.g. https://x.com/<you>
NEXT_PUBLIC_CONTACT_URL=
# A showcase (an event, a booth): memories can be walked into, not made. No uploads.
EXPLORE_ONLY=

# Milestone 3: scene analysis, hero objects, sound.
FAL_KEY=
ELEVENLABS_API_KEY=
# Vision: Gemini direct with a Google AI Studio key (preferred), else a model via fal/OpenRouter.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
VISION_MODEL=google/gemini-2.5-flash
# Jev (TypeSafe): calibrated decisions over the scene manifest. Optional; without it the
# vision model's own calls are used and shared memories publish unscreened.
TYPESAFE_API_KEY=
# Image-to-3D: trellis ($0.02, default) | trellis-2 ($0.25) | hunyuan3d-v3 ($0.375)
MESH_MODEL=trellis
# fal (default) or local (development: files under .data/files; remote models can't read them)
STORAGE=
# Extras bill your fal/ElevenLabs accounts; off for visitors using their own World Labs key.
EXTRAS_FOR_OWN_KEYS=false

# Upstash Redis for quotas + gallery (required on Vercel). Locally, .data/store.json is used.
KV_REST_API_URL=
KV_REST_API_TOKEN=
